{
	"name": "donation-qr-block",
	"version": "1.0.0",
	"description": "Display an EPC/GiroCode QR code for SEPA bank donations.",
	"author": "remotedots.com",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"packages-update": "wp-scripts packages-update",
		"playground": "npx -y @wp-playground/cli@latest server --wp=beta --php=8.4 --mount=.:/wordpress/wp-content/plugins/donation-qr-block --blueprint=./blueprint.json",
		"playground:stable": "npx -y @wp-playground/cli@latest server --wp=latest --php=8.4 --mount=.:/wordpress/wp-content/plugins/donation-qr-block --blueprint=./blueprint.json",
		"plugin-zip": "wp-scripts plugin-zip && zip -ur donation-qr-block.zip vendor/ src/ composer.json package.json && mkdir -p dist && mv donation-qr-block.zip dist/"
	},
	"devDependencies": {
		"@babel/runtime": "^7.28.6",
		"@wordpress/scripts": "^28.0.0"
	},
	"dependencies": {
		"qrcode": "^1.5.4"
	}
}
